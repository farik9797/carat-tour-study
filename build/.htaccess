# Carat Tour & Study — Apache
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Без www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # HTTPS — включить ПОСЛЕ выпуска SSL-сертификата (иначе браузеры покажут ошибку).
  # На Timeweb nginx проксирует в Apache по http, поэтому %{HTTPS} всегда off — смотрим X-Forwarded-Proto.
  # RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://carattourandstudy.uz%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # После включения HTTPS: Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.(webp|avif|jpg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain application/json
</IfModule>

AddType image/webp .webp
AddType image/avif .avif
